# Backend-only Dockerfile for API deployment
FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy backend requirements and install
COPY webapp/backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code (includes all Python modules)
COPY webapp/backend/ ./backend/

# Set Python path to include current directory for module imports
ENV PYTHONPATH=/app

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:5000/api/health')" || exit 1

# Run the application
# For development: CMD ["python", "backend/app.py"]
# For production: CMD ["gunicorn", "-c", "backend/gunicorn_config.py", "backend.app:app"]
CMD ["gunicorn", "-c", "backend/gunicorn_config.py", "backend.app:app"]
