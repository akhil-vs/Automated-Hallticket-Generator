{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "webapp/Dockerfile.backend"
  },
  "deploy": {
    "startCommand": "gunicorn -c backend/gunicorn_config.py backend.app:app",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
